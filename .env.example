# Chave da Anthropic usada pelo agente. Sem ela a pagina sobe, e o chat devolve
# erro do provedor.
ANTHROPIC_API_KEY=

# Corta a demo na hora, sem redeploy.
DEMO_KILL_SWITCH=0

# Teto diario em dolar, somando todas as sessoes, e a reserva retida antes de cada
# turno. O teto e o kill switch existem porque a chave paga fica atras de uma
# pagina publica.
DAILY_BUDGET_USD=3.00
TURN_RESERVE_USD=0.05

# Opcionais. AGENT_MODEL precisa ter tarifa em agent/src/pricing.yaml.
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=low
